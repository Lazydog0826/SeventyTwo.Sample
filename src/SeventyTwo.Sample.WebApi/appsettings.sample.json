{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsConfiguration": {
    "Origins": "http://localhost:5173",
    "Headers": "Authorization,Content-Type",
    "Methods": "GET,POST,PUT,DELETE,OPTIONS"
  },
  "JwtConfiguration": {
    "Issuer": "SeventyTwo.Sample",
    "Audience": "SeventyTwo.Sample.Client",
    "SigningKey": "",
    "EncryptionKey": "",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=SeventyTwo.Sample;Username=postgres;Password=your_password"
  },
  "CapConfiguration": {
    "RabbitMqHostName": "localhost",
    "RabbitMqUserName": "your_username",
    "RabbitMqPassword": "your_password",
    "RabbitMqVirtualHost": "your_virtual_host"
  },
  "CapDashboardAuthenticationConfiguration": {
    "UserName": "your_username",
    "Password": "your_password"
  },
  "CacheConfiguration": {
    "ConnectionString": "localhost:6379,password=your_password,abortConnect=false",
    "KeyNamespace": "seventytwo-infrakit",
    "DefaultDb": 0
  }
}
